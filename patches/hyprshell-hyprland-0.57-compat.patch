+/// How a workspace has to be selected in dispatchers, derived from its address
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum WorkspaceTarget {
+    /// numbered workspace (address is the number)
+    Numbered(i32),
+    /// named workspace (address is the name)
+    Named(String),
+    /// special workspace (address is `special:<name>`, this holds the name without prefix)
+    Special(String),
+}
+
+impl WorkspaceTarget {
+    fn from_address(address: &str) -> Self {
+        if let Some(name) = address.strip_prefix("special:") {
+            Self::Special(name.to_string())
+        } else if let Ok(id) = address.parse::<i32>() {
+            Self::Numbered(id)
+        } else {
+            Self::Named(address.to_string())
+        }
+    }
+}
+
