+    /// On a fast tap the modifier is already up before the window is focused, so no release is
+    /// ever seen. Once focused the compositor reports the real modifier state: check it then.
+    fn close_if_modifier_released(&self, sender: &ComponentSender<Self>) {
+        let modifier = self.switch.modifier;
+        let window = self.window.clone();
+        let sender = sender.clone();
+        let mut polls = 0;
+        glib::timeout_add_local(Duration::from_millis(25), move || {
+            polls += 1;
+            if !window.is_visible() {
+                return ControlFlow::Break;
+            }
+            if !window.is_active() && polls < 20 {
+                return ControlFlow::Continue;
+            }
+            if !modifier_held(modifier) {
+                sender.input_sender().emit(SwitchRootInput::CloseSwitch(true));
+            }
+            ControlFlow::Break
+        });
+    }
+
     fn open_switch(&mut self, direction: Direction) {
