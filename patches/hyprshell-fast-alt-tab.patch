@@ -131,7 +130,7 @@ pub fn apply_exec_bind_legacy(bind: &ExecBind) -> anyhow::Result<()> {
         flags: if bind.release {
             &[binds::Flag::r, binds::Flag::t]
         } else {
-            &[binds::Flag::e]
