 /// > its a type because it might change at some point
 pub type WorkspaceId = i32;
 
+/// The kind of a workspace as reported by Hyprland (`type` field, 0.57+)
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]
+#[serde(rename_all = "lowercase")]
+pub enum WorkspaceKind {
+    /// A regular workspace, either numbered or named
+    #[default]
+    Normal,
+    /// A special workspace (scratchpad)
+    Special,
+}
+
+/// Works out the stable address and the kind of a workspace.
+///
+/// Hyprland 0.57 removed the global numeric id: workspaces are identified by an
+/// `address` (`3`, `foo` or `special:foo`) and `id` only exists for numbered workspaces.
+/// Older versions only send `id` (negative for special workspaces) and `name`.
+/// For those the address is derived (`id` for regular workspaces, `name` for special ones),
+/// an empty address means "no workspace" (unused special workspace, invalid workspace)
+pub(crate) fn resolve_workspace_identity(
+    id: Option<WorkspaceId>,
+    address: Option<String>,
+    kind: Option<&str>,
+    name: &str,
+) -> (String, WorkspaceKind) {
+    if let Some(address) = address {
+        let kind = if kind == Some("special") || address.starts_with("special:") {
+            WorkspaceKind::Special
+        } else {
+            WorkspaceKind::Normal
+        };
+        return (address, kind);
+    }
+    match id {
+        Some(id) if id > 0 => (id.to_string(), WorkspaceKind::Normal),
+        Some(id) if id < -1 => (name.to_string(), WorkspaceKind::Special),
+        _ => (String::new(), WorkspaceKind::Normal),
+    }
+}
+
+/// Returns the selector that can be passed to workspace dispatchers for a workspace address
+///
+/// numbered workspaces are selected by number, named ones need the `name:` prefix
+/// and special ones are already prefixed with `special:`
+#[must_use]
+pub fn workspace_selector(address: &str, kind: WorkspaceKind) -> String {
+    match kind {
+        WorkspaceKind::Special => address.to_string(),
+        WorkspaceKind::Normal if address.parse::<u32>().is_ok() => address.to_string(),
+        WorkspaceKind::Normal => format!("name:{address}"),
+    }
+}
