-pub type WorkspaceId = i32;
+/// The stable address of a workspace (`3`, `foo` or `special:foo`).
+///
+/// Since Hyprland 0.57 workspaces no longer have a numeric id (only numbered workspaces do),
+/// the address is the only identity every workspace has.
+pub type WorkspaceId = String;
 pub type MonitorId = i128;
 pub type ClientId = u64;
 
-#[derive(Debug, Clone, Copy, Eq, PartialEq)]
