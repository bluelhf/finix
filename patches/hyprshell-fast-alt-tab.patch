 const KILL_TIMEOUT: Duration = Duration::from_millis(200);
 
+/// Whether the switch modifier is held on the default seat's keyboard (`true` if unknown).
+fn modifier_held(modifier: config_lib::Modifier) -> bool {
+    use relm4::gtk::gdk::ModifierType;
+    let mask = match modifier {
+        config_lib::Modifier::Alt => ModifierType::ALT_MASK,
+        config_lib::Modifier::Ctrl => ModifierType::CONTROL_MASK,
+        config_lib::Modifier::Super => ModifierType::SUPER_MASK,
+        config_lib::Modifier::None => return true,
+    };
+    relm4::gtk::gdk::Display::default()
+        .and_then(|d| d.default_seat())
+        .and_then(|s| s.keyboard())
+        .is_none_or(|kb| kb.modifier_state().contains(mask))
+}
