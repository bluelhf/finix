@@ -52,6 +56,25 @@ pub struct HyprlandData {
     pub monitors: Vec<(MonitorId, MonitorData)>,
 }
 
+/// Is the workspace address the address of a special workspace
+#[must_use]
+pub fn is_special_workspace(address: &str) -> bool {
+    address.starts_with("special:")
+}
+
+/// Key to sort workspaces by their address: special workspaces first,
+/// then numbered workspaces by number and named workspaces by name
+#[must_use]
+pub fn workspace_sort_key(address: &str) -> (u8, u32, &str) {
+    if is_special_workspace(address) {
+        (0, 0, address)
+    } else if let Ok(number) = address.parse::<u32>() {
+        (1, number, address)
+    } else {
+        (2, 0, address)
+    }
+}
+
 pub trait ByFirst<ID, Data> {
     fn find_by_first(&self, id: &ID) -> Option<&Data>;
 }
